DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
# Optional: instant command registration in one test server.
GUILD_ID=your_test_server_id
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=red_mushroom_bot
# Central authorization for global bot-management commands such as /maintenance.
CONTROL_GUILD_ID=1399834742802747452
GLOBAL_CONFIG_ROLE_ID=1544634974404214824

# Separate web portal process (`npm run web`). Keep both secrets private.
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
SESSION_SECRET=replace_with_at_least_32_random_characters
WEB_BASE_URL=https://dashboard.example.com
WEB_PORT=3000
# Enable this when HTTPS is terminated by Caddy, nginx, or another reverse proxy.
WEB_TRUST_PROXY=true
